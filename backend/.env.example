PORT=3000
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
DB_HOST=localhost
DB_PORT=5432
DB_NAME=copa_leyendas
DB_USER=postgres
DB_PASSWORD=postgres
DB_SYNCHRONIZE=false
DB_LOGGING=false
# Copias de PostgreSQL. Horario y retencion se configuran en Administracion > Backups.
# Por defecto: shared/backups en el servidor, storage/backups en desarrollo.
# BACKUP_STORAGE_DIR=/var/www/copa-leyendas/shared/backups
# PG_DUMP_BINARY=pg_dump
SEED_ADMIN_EMAIL=admin@copaleyendas.local
SEED_ADMIN_PASSWORD=copa123
SEED_ADMIN_NAME=Administracion Copa Leyendas
# PAYMENT_PROOF_STORAGE_DIR=/var/www/copa-leyendas/shared/payment-proofs
# ID de la carpeta raiz "Copa Leyendas". El backend crea una carpeta por torneo y dentro "Fotos Jugadores".
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# JSON de cuenta de servicio (una linea) o su contenido codificado en base64.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# WhatsApp Cloud API. Copiar la version habilitada que muestra Meta (formato vNN.N).
WHATSAPP_GRAPH_API_VERSION=
# Identificador numerico del numero de telefono; no es el numero visible.
WHATSAPP_PHONE_NUMBER_ID=
# Token permanente de un usuario del sistema con permisos de WhatsApp.
WHATSAPP_ACCESS_TOKEN=
# Valor secreto elegido por nosotros para verificar el alta del webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
# Se obtiene en Meta for Developers > Configuracion de la app > Basica.
WHATSAPP_APP_SECRET=
# Plantilla aprobada en Meta para iniciar conversaciones de inscripcion.
# Debe tener 4 variables de cuerpo: contacto, equipo, categoria, enlace completo.
# Ver docs/whatsapp-registration-template.md. Estos son los valores por defecto.
WHATSAPP_REGISTRATION_TEMPLATE_NAME=inscripcion_copa_leyendas
WHATSAPP_REGISTRATION_TEMPLATE_LANGUAGE=es_AR
